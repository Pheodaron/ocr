# Compose host port (localhost only)
OCR_PORT=8000
OCR_CPU_THREADS=4
OCR_DPI=250
OCR_RETRY_DPI=350
OCR_REVIEW_THRESHOLD=0.75
OCR_LAYOUT_THRESHOLD=0.5
OCR_MAX_UPLOAD_MB=64
OCR_MAX_PAGES=300
OCR_MAX_PAGE_PIXELS=30000000
# First launch downloads weights in the separate models container.
# Set false when models are already imported and no network access is allowed.
OCR_ALLOW_MODEL_DOWNLOAD=true
