# Compose host port (localhost only)
OCR_PORT=8000
OCR_CPU_THREADS=4
# PP-StructureV3 rendering and quality retry only.
OCR_DPI=250
OCR_RETRY_DPI=350
# All other backends: one pass at this DPI, no higher-DPI error retry.
OCR_VLM_DPI=150
OCR_REVIEW_THRESHOLD=0.75
OCR_LAYOUT_THRESHOLD=0.5
OCR_MAX_UPLOAD_MB=64
OCR_MAX_PAGES=300
OCR_MAX_PAGE_PIXELS=30000000
# First launch downloads weights in the separate models container.
# Set false when models are already imported and no network access is allowed.
OCR_ALLOW_MODEL_DOWNLOAD=true
# Available configurations in API/client. Compose profiles control which service runs.
OCR_ENABLED_BACKENDS=paddle,dots_mocr,glm_ocr,chandra,lighton,kdl,lighton_small,jina,surya,falcon,nemotron
# dots decoder: Q5_K_M, Q8_0 or BF16; its vision projector stays Q8_0.
OCR_DOTS_QUANTIZATION=Q5_K_M
OCR_DOTS_CONTEXT=32768
# GLM supports 131072; start with 16384 to reduce KV-cache memory.
OCR_GLM_CONTEXT=16384
# text = full-page text; table = Table Recognition for table-heavy pages.
OCR_GLM_TASK=text
OCR_VLM_CONTEXT=16384
# Maximum image area sent to llama.cpp; render previews keep their original DPI.
OCR_VLM_MAX_PIXELS=1500000
# dots.mocr uses the smaller of this budget and OCR_VLM_MAX_PIXELS.
# Increase to 1500000 for small text, at the cost of CPU time and RAM.
OCR_DOTS_MAX_PIXELS=1000000
OCR_VLM_MAX_TOKENS=8192
OCR_KV_CACHE_TYPE=q8_0
OCR_VLM_TIMEOUT_SECONDS=3600
OCR_VLM_STARTUP_SECONDS=300
# For local mise/uv only: Compose contains the pinned binary.
OCR_LLAMA_SERVER=llama-server

# Local mise/uv worker only. Compose sets its own backend per service.
OCR_WORKER_BACKEND=paddle
