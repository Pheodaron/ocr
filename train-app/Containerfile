# syntax=docker/dockerfile:1
FROM node:24-alpine AS frontend
WORKDIR /build
COPY frontend/ ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --no-audit --no-fund && npm run build && \
    rm -rf node_modules /root/.npm

FROM ghcr.io/astral-sh/uv:0.12.23 AS uv
FROM python:3.12-slim-bookworm AS app
WORKDIR /app
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PATH=/app/.venv/bin:$PATH \
    TRAIN_DATA_DIR=/data TRAIN_FRONTEND_DIR=/app/frontend/dist
COPY . ./
# Build tools and the intermediate interface remain outside the final image.
RUN --mount=type=bind,from=uv,source=/uv,target=/usr/local/bin/uv \
    --mount=type=bind,from=frontend,source=/build/dist,target=/built-interface \
    --mount=type=secret,id=proxy_ca \
    --mount=type=cache,target=/root/.cache/uv \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    uv sync --frozen --no-dev --no-editable && \
    mkdir -p frontend/dist && cp -R /built-interface/. frontend/dist/ && \
    rm -rf frontend/src frontend/e2e
EXPOSE 8001
CMD ["uvicorn", "train_app.main:app", "--host", "0.0.0.0", "--port", "8001"]
