# syntax=docker/dockerfile:1
FROM debian:bookworm-slim AS llama-cpu
ARG LLAMA_CPP_REF=fa6769818708afd9807b22183ccda112fd563427
RUN apt-get update && apt-get install -y --no-install-recommends git cmake ninja-build g++ libcurl4-openssl-dev ca-certificates && rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export GIT_SSL_CAINFO=/run/secrets/proxy_ca; fi; \
    git init /source && cd /source && git remote add origin https://github.com/ggml-org/llama.cpp.git && \
    git fetch --depth 1 origin "$LLAMA_CPP_REF" && git checkout --detach FETCH_HEAD
RUN cmake -S /source -B /source/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DGGML_CUDA=OFF -DGGML_NATIVE=OFF -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=ON && cmake --build /source/build --target llama-server llama-quantize -j 4

FROM ghcr.io/astral-sh/uv:0.12.23 AS uv
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv libcurl4t64 libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=llama-cpu /source/ /opt/llama/source/
COPY --from=llama-cpu /source/build/bin/ /opt/llama/bin/
WORKDIR /app
ENV UV_LINK_MODE=copy PATH=/app/.venv/bin:$PATH LD_LIBRARY_PATH=/opt/llama/bin:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64 \
    TRAIN_DATA_DIR=/data HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    PYTHONPATH=/opt/llama/source/gguf-py HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=8
COPY pyproject.toml uv.lock ./
COPY src/ src/
RUN --mount=type=secret,id=proxy_ca \
    --mount=type=cache,target=/root/.cache/uv \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    uv sync --frozen --extra gpu --no-dev --no-editable
EXPOSE 8090
CMD ["uvicorn", "train_app.compute.service:app", "--host", "0.0.0.0", "--port", "8090"]
